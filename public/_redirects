# Redirects for lakotafox.com. This file ships INSIDE the publish dir, so it
# deploys atomically with the site and takes precedence over netlify.toml —
# whose redirect changes stopped being picked up by Netlify around mid-July
# (builds read the toml fine; the serving layer kept ~11 stale rules. The
# proof: /puddl3-api/*, /reallycoolhair/* deep links, and any rule added
# after July 2026 fell through to the SPA catch-all until this file).
# Keep netlify.toml's [[redirects]] in sync as documentation, but THIS file
# is what production actually serves. "!" = force.

# --- function proxies ---
/api/identify         /.netlify/functions/identify            200!
/puddl3-api/*         /.netlify/functions/puddl3-api/:splat   200!
/gifsmith-api/search  /.netlify/functions/gifcities-search    200!

# NOTE: no clean-URL rules for the static app folders (/gifsmith, /plant-id,
# …) — in _redirects a rule for "/x" ALSO matches "/x/", so a forced
# "/x -> /x/" redirect loops forever. Netlify's automatic trailing-slash
# folder redirect already handles those URLs.

# --- livestream pages: clean URLs -> static .html ---
/free   /demo.html   200!
/fred   /fred.html   200!
/games  /games.html  200!
/tank   /tank.html   200!
/battle /battle.html 200!

# --- sub-app SPA catch-alls (before the portfolio's) ---
/reallycoolhair/admin/* /reallycoolhair/admin/index.html 200
/reallycoolhair/app/*   /reallycoolhair/app/index.html   200


# --- PUDDL3 P4RTS component library — proxied to its own password-gated
# Netlify site (puddl3-p4rts.netlify.app). The app is built with base
# /PUDDL3P4RTS/ so its own assets ride the first rule; the extra namespaces
# cover hardcoded root-absolute references (iframes, template/scene assets).
# All non-forced: any real portfolio file on the same path wins.
/PUDDL3P4RTS/*      https://puddl3-p4rts.netlify.app/PUDDL3P4RTS/:splat  200
/PUDDL3P4RTS        https://puddl3-p4rts.netlify.app/PUDDL3P4RTS/        200
/preview.html       https://puddl3-p4rts.netlify.app/preview.html        200
/template.html      https://puddl3-p4rts.netlify.app/template.html       200
/scene/*            https://puddl3-p4rts.netlify.app/scene/:splat        200
/t/*                https://puddl3-p4rts.netlify.app/t/:splat            200
/three-vendor/*     https://puddl3-p4rts.netlify.app/three-vendor/:splat 200
/pro-manifest.json  https://puddl3-p4rts.netlify.app/pro-manifest.json   200
/assets/*           https://puddl3-p4rts.netlify.app/assets/:splat       200

# --- portfolio SPA catch-all (must stay last) ---
/* /index.html 200
